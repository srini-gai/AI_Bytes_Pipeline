# Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ElevenLabs TTS — one voice ID per language
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID_EN=your-english-voice-id
ELEVENLABS_VOICE_ID_TA=your-tamil-voice-id

# ElevenLabs voice delivery settings (optional — safe defaults shown below)
# Run scripts/voice_test.py to audition variants before changing these.
# Prefer tighter scripts over high speed for duration control.
# Speed above 1.08 degrades articulation — do not use as a duration band-aid.
#
#   Variant A — Natural:              stability=0.50 similarity=0.75 style=0 speed=1.00
#   Variant B — Creator/Recommended:  stability=0.42 similarity=0.78 style=0 speed=1.05
#   Variant C — More Energetic:       stability=0.35 similarity=0.78 style=0 speed=1.07
#
ELEVENLABS_STABILITY=0.42
ELEVENLABS_SIMILARITY=0.78
ELEVENLABS_STYLE=0
ELEVENLABS_SPEED=1.05
ELEVENLABS_SPEAKER_BOOST=true

# YouTube OAuth2 — one refresh token per channel
# EN: YOUTUBE_REFRESH_TOKEN_EN preferred; falls back to YOUTUBE_REFRESH_TOKEN
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REFRESH_TOKEN=your-english-refresh-token
YOUTUBE_REFRESH_TOKEN_EN=your-english-refresh-token
YOUTUBE_REFRESH_TOKEN_TA=your-tamil-refresh-token
YOUTUBE_CHANNEL_ID_EN=UCxxxxxxx-english-channel
YOUTUBE_CHANNEL_ID_TA=UCxxxxxxx-tamil-channel

# Pipeline config
LANGUAGES=en,ta
OUTPUT_BASE_PATH=./output
PUBLISH_TIME_UTC=02:30
START_PUBLISH_DATE=2026-05-12

# Pexels video backgrounds (optional — dark gradient used if absent)
PEXELS_API_KEY=your-pexels-api-key

# Background music bed (optional — voice-only if absent)
BACKGROUND_MUSIC_PATH=./assets/lofi_bed.mp3
