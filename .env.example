# Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ElevenLabs TTS — one voice ID per language
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID_EN=your-english-voice-id
ELEVENLABS_VOICE_ID_TA=your-tamil-voice-id

# YouTube OAuth2 — one channel per language
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REFRESH_TOKEN=your-refresh-token
YOUTUBE_CHANNEL_ID_EN=UCxxxxxxx-english-channel
YOUTUBE_CHANNEL_ID_TA=UCxxxxxxx-tamil-channel

# Pipeline config
LANGUAGES=en,ta
OUTPUT_BASE_PATH=./output
PUBLISH_TIME_UTC=02:30
START_PUBLISH_DATE=2026-05-12

# Pexels video backgrounds (optional — dark gradient used if absent)
PEXELS_API_KEY=your-pexels-api-key

# Background music bed (optional — voice-only if absent)
BACKGROUND_MUSIC_PATH=./assets/lofi_bed.mp3
